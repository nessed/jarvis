GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_URL=
META_VERIFY_TOKEN=
OLLAMA_EMBEDDING_MODEL=
OLLAMA_BASE_URL=
MEMORY_DB_PATH=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_ID=
BUS_BEARER_TOKEN=
DEEPSEEK_VIA_OPENROUTER=false

# Queue client (db/jobs.py)
SUPABASE_SECRET_KEY=
SUPABASE_QUEUE_TIMEOUT_SECONDS=

# Router provider defaults (router/providers.yaml, router/routing.py)
GROQ_DEFAULT_MODEL=
CEREBRAS_DEFAULT_MODEL=
NVIDIA_DEFAULT_MODEL=
GEMINI_DEFAULT_MODEL=
MISTRAL_DEFAULT_MODEL=
CLAUDE_API_BASE_URL=
CLAUDE_API_DEFAULT_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_DEEPSEEK_MODEL=
# Per-call deadline for the interactive `latency` profile, in seconds (default
# 20). The whole cascade gets twice this, so one attempt plus one fallback.
JARVIS_ROUTER_CALL_TIMEOUT_SECONDS=
# Per-call deadline for every other profile — batch, long_context, vision,
# reasoning — and for model discovery, in seconds (default 120).
JARVIS_ROUTER_BATCH_TIMEOUT_SECONDS=

# Executor / memory tuning
JARVIS_MEMORY_WRITES=
JARVIS_DISTILL=
JARVIS_POLL_INTERVAL_SECONDS=
# The WhatsApp sender id this assistant answers to. Unset means every sender
# is treated as a stranger: generic replies, no recall, no actions.
JARVIS_OWNER_WA_ID=
JARVIS_EXECUTOR_HEARTBEAT=
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=
OLLAMA_FACT_EXTRACTION_MODEL=
# Must stay below the distill handler's own timeout (240s) or the executor
# refuses to start (assert_timeouts_ordered in executor/handlers/distill.py).
OLLAMA_FACT_EXTRACTION_TIMEOUT_SECONDS=
