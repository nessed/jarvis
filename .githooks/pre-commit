#!/bin/sh
# Refuse a commit while the offline suite is red.
#
# This exists because a lane once cited a green focused run (`pytest -q
# tests\memory` -> 45 passed) while the tree was red: a JobRepository Protocol
# widened in one lane, its test double stranded in a file no lane owned. The
# citation satisfied the evidence rule and still shipped a broken tree. Rules
# that depend on remembering to run the wider command do not hold; this does.
#
# The suite is run bare. Everything this used to hand-carry now lives in
# pytest.ini's addopts and conftest.py -- see those files for why the system
# TEMP and .pytest_cache are both unusable on this machine. A hook that
# repeats flags is a hook that drifts from the documented command.

PY=".venv/Scripts/python.exe"
[ -x "$PY" ] || PY=".venv/bin/python"
if [ ! -x "$PY" ]; then
    echo "pre-commit: no .venv interpreter found; skipping suite" >&2
    exit 0
fi

echo "pre-commit: running full offline suite..." >&2
OUTPUT=$("$PY" -m pytest -q 2>&1)
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "$OUTPUT" | tail -30 >&2
    echo "" >&2
    echo "pre-commit: offline suite is red. Fix it, or commit with --no-verify" >&2
    echo "and say plainly in the message that the tree is red and why." >&2
    exit 1
fi

SUMMARY=$(echo "$OUTPUT" | tail -1)
echo "$SUMMARY" >&2

# Refresh the generated status block in docs/context.md and stage it. Nothing
# in that block is hand-written: it is HEAD, recent commits, working tree state
# and the suite result that just ran. Hand-maintaining those is what made the
# old context.md wrong for days at a time.
"$PY" tools/context_status.py --record-suite "$SUMMARY" --write 2>&1 >&2
git add docs/context.md

exit 0
